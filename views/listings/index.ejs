<style>
    /* Main container */
.filters-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #ddd;
  background-color: #fff;
  padding: 10px 20px;
  gap: 20px;
  overflow: hidden;
  flex-wrap: nowrap;
}

/* Scrollable filters area */
.filters-scroll {
  display: flex;
  flex: 1;
  overflow-x: auto;
  scroll-behavior: smooth;
  gap: 20px;
  scrollbar-width: none; /* Firefox */
}

.filters-scroll::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}

/* Each filter */
.filter {
  flex: 0 0 auto;
  text-align: center;
  cursor: pointer;
  color: #555;
  transition: all 0.3s ease;
  width: 80px;
}

.filter i {
  font-size: 20px;
  margin-bottom: 5px;
}

.filter:hover {
  color: #000;
  transform: scale(1.05);
}

/* Tax toggle section */
.tax-toggle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  white-space: nowrap;
  border: 1px solid black;
  border-radius: 1rem;
  height: 3.25rem;
        padding: 1rem;
        margin-left: 3rem;
}

.tax-toggle label {
  font-size: 14px;
  margin-left: 5px;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .filter {
    width: 60px;
  }

  .tax-toggle label {
    display: none; /* Hide label text on very small screens */
  }
}

@media (max-width: 500px) {
  .filters-container {
    padding: 8px 10px;
  }
}
/* Smaller icons and text inside filters */
#filters .filter i {
  font-size: 16px;   /* previously ~24px */
}

#filters .filter p {
  font-size: 12px;   /* smaller text */
  margin-top: 3px;
}

/* Optional: adjust for small screens */
@media (max-width: 768px) {
  #filters .filter i {
    font-size: 14px;
  }

  #filters .filter p {
    font-size: 10px;
  }
}
